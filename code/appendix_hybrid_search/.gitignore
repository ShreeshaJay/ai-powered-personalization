# Caches and vectors. Regenerated by the scripts. Never publish Naver-derived
# vectors or indexes (CC BY-NC-SA 4.0, evaluation only).
cache/
*.npy
*.npz
*.index
*.faiss

# Generated runs and metrics. The results directory is the only place a
# later full-catalog run may leave small CSV and JSON files.
outputs/*
!outputs/results/
outputs/results/*
!outputs/results/.gitkeep
!outputs/results/*.csv
!outputs/results/*.json

# Saved labels and disagreement scores are not part of this folder.
**/llm_labels.json
**/*labeling*.json
**/*disagreement*.json
**/*disagreements*.json
**/*disagreements*.txt

# Secrets and local environments.
.env
**/.env
.venv/
venv/
.venvs/

# Bundles that must not be synced.
**/colab_bundle.zip
**/open_model_results.zip

# Python, notebooks, editors, OS files.
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
.ipynb_checkpoints/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

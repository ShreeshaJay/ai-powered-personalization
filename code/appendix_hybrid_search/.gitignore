# Cached indexes (large, regenerable from scripts)
cache/
*.npy
*.npz
*.index

# Evaluation outputs (large plots and raw data excluded, key results kept)
outputs/plots/
!outputs/metrics/
!outputs/metrics/*.json
!outputs/metrics/*.csv

# Large or paid-run outputs that the whitelist above would otherwise keep
outputs/metrics/llm_labels.json
outputs/metrics/llm_benchmark_*_details.csv
*disagreement*.json

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
.venvs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints/

# LLM labeling artifacts (not part of this appendix)
*labeling*.json
*disagreements*.json
*disagreements*.txt

# Colab upload artifact
**/colab_bundle.zip
**/open_model_results.zip

# Secrets
.env
**/.env
